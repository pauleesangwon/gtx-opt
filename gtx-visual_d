import pandas as pd
import numpy as np
import folium
from folium.plugins import HeatMap
from sklearn.metrics.pairwise import haversine_distances
import webbrowser
import os

# ==============================================================================
# 1. 데이터 로드 및 전처리
# ==============================================================================
print("데이터를 불러오는 중입니다...")
try:
    station_df = pd.read_excel('역_최종.xlsx')
    workplace_df = pd.read_excel('사업장_최종.xlsx')
except FileNotFoundError:
    print("오류: 엑셀 파일을 찾을 수 없습니다.")
    exit()

# 위경도 -> 라디안 변환
station_df['rad_lat'] = np.radians(station_df['위도'])
station_df['rad_lon'] = np.radians(station_df['경도'])
workplace_df['rad_lat'] = np.radians(workplace_df['위도'])
workplace_df['rad_lon'] = np.radians(workplace_df['경도'])

# 공급지(Origin) 설정: 순승차 인원이 있는 역
origin_stations = station_df[station_df['승하차인원'] > 0].copy()

# ==============================================================================
# 2. 교통 사각지대(Blind Spot) 회사 추출
# ==============================================================================
print("1단계: 교통 사각지대(반경 5km 밖) 회사를 추출합니다...")

all_st_coords = station_df[['rad_lat', 'rad_lon']].to_numpy()
all_co_coords = workplace_df[['rad_lat', 'rad_lon']].to_numpy()

# 모든 회사 -> 가장 가까운 역까지의 거리 계산
dist_mat = haversine_distances(all_co_coords, all_st_coords) * 6371
min_dists = dist_mat.min(axis=1)

# 필터링: 5km 이상 떨어진 회사만 선택
target_mask = min_dists >= 5.0
target_companies = workplace_df[target_mask].copy()

print(f" -> 전체 {len(workplace_df)}개 중 {len(target_companies)}개 회사가 분석 대상입니다.")

# ==============================================================================
# 3. 중력 모형 점수 계산 (Total Gravity Score)
# ==============================================================================
print("2단계: 중력 모형으로 잠재 수요 점수를 계산합니다...")

origin_coords = origin_stations[['rad_lat', 'rad_lon']].to_numpy()
target_coords = target_companies[['rad_lat', 'rad_lon']].to_numpy()

# 거리 계산 (Origin x Target)
dist_O_to_D = haversine_distances(origin_coords, target_coords) * 6371

# 마찰 계수 (거리의 제곱에 반비례)
friction = 1 / ((dist_O_to_D + 0.001) ** 2)

# 공급(Supply) & 유인(Attraction)
supply = origin_stations['승하차인원'].to_numpy().reshape(-1, 1)
attraction = target_companies['가입자수'].to_numpy().reshape(1, -1)

# Gravity Score 매트릭스 계산
gravity_scores = supply * attraction * friction

# 각 회사별 총점 합산 (모든 역에서의 유입 잠재력 총합)
total_scores = gravity_scores.sum(axis=0)
target_companies['total_gravity_score'] = total_scores

# ==============================================================================
# 4. 히트맵 시각화 (Folium)
# ==============================================================================
print("3단계: 지도를 그리는 중입니다...")

# 지도의 중심: 타겟 회사들의 평균 위치
center_lat = target_companies['위도'].mean()
center_lon = target_companies['경도'].mean()

# 지도 생성 (배경: 깔끔한 CartoDB Positron)
m = folium.Map(location=[center_lat, center_lon], zoom_start=10, tiles='cartodbpositron')

# --- [히트맵 설정] ---
# 가중치 정규화 (0~1 사이 값으로 변환해야 색상이 예쁘게 나옴)
max_score = target_companies['total_gravity_score'].max()
target_companies['norm_score'] = target_companies['total_gravity_score'] / max_score

# 데이터 준비: [위도, 경도, 가중치]
heat_data = target_companies[['위도', '경도', 'norm_score']].values.tolist()

# 히트맵 레이어 추가
HeatMap(
    heat_data,
    min_opacity=0.3,
    radius=20,
    blur=15,
    max_zoom=10,
    gradient={0.2: 'blue', 0.4: 'lime', 0.6: 'yellow', 1.0: 'red'}
).add_to(m)

# --- [Top 50 핀(Marker) 추가] ---
top_50 = target_companies.sort_values(by='total_gravity_score', ascending=False).head(50)

for idx, row in top_50.iterrows():
    popup_content = f"""
    <div style="width:200px">
        <h4>{row['사업장명']}</h4>
        <b>주소:</b> {row['Final_Address']}<br>
        <b>직원수:</b> {row['가입자수']:,}명<br>
        <b>중력점수:</b> {int(row['total_gravity_score']):,}<br>
        <hr>
        <i>*교통사각지대 1순위 후보*</i>
    </div>
    """
    
    folium.CircleMarker(
        location=[row['위도'], row['경도']],
        radius=3,
        color='red',
        fill=True,
        fill_color='red',
        fill_opacity=0.7,
        popup=folium.Popup(popup_content, max_width=300),
        tooltip=f"{row['사업장명']} (Click!)"
    ).add_to(m)

# ==============================================================================
# 5. 저장 및 실행
# ==============================================================================
output_file = 'BlindSpot_Heatmap.html'
m.save(output_file)

print(f"\n[성공] '{output_file}' 파일이 생성되었습니다.")
print("웹 브라우저로 지도를 엽니다...")

webbrowser.open('file://' + os.path.realpath(output_file))


